{
  "expo": {
    "name": "Gradient",
    "slug": "gradient-hac",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "kingjayan",
    "runtimeVersion": "1.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060F0B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kingjayan.gradient",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Gradient uses Face ID to lock the app so only you can view your grades."
      },
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static",
            "newArchEnabled": false
          }
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-asset",
      "expo-font"
    ],
    "scheme": "gradient",
    "extra": {
      "apiBaseUrl": "https://gradient-hac-api.vercel.app",
      "demoMode": true,
      "eas": {
        "projectId": "774b8478-2c1e-428b-a313-462ed7638fb1"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
