{
  "expo": {
    "name": "Gradient",
    "slug": "gradient-hac",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "kingjayan",
    "runtimeVersion": "1.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060F0B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.kingjayan.gradient",
      "buildNumber": "1",
      "deploymentTarget": "14.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Gradient uses Face ID to lock the app so only you can view your grades."
      },
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "newArchEnabled": false
          }
        }
      ],
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "scheme": "gradient",
    "extra": {
      "apiBaseUrl": "https://gradient-hac-api.vercel.app",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
