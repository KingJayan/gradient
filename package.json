{
  "name": "gradient-hac",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "assets": "node scripts/generate-assets.mjs",
    "build:ios": "eas build --platform ios",
    "build:ios-simulator": "eas build --platform ios --profile preview",
    "update": "eas update --auto",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "precommit": "pnpm type-check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "6.5.20",
    "@react-navigation/native": "6.1.17",
    "@react-navigation/native-stack": "6.9.18",
    "@sentry/react-native": "~7.2.0",
    "expo": "^54.0.36",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-asset": "~12.0.13",
    "expo-background-task": "^57.0.5",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~57.0.1",
    "expo-font": "~14.0.12",
    "expo-haptics": "^57.0.1",
    "expo-local-authentication": "~17.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "^31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "^57.0.5",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.9",
    "@types/react": "~19.1.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-preset-expo": "^54.0.12",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.35.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^expo-constants$": "<rootDir>/test/expo-constants-mock.ts"
    }
  },
  "description": "Gradient - A feature-packed HAC grade viewer for mobile.",
  "main": "./index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
